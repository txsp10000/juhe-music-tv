<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="20dp"
        android:paddingEnd="48dp"
        android:paddingBottom="14dp">

        <!-- 左侧：封面信息区 -->
        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="36dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- 封面卡片 -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@drawable/bg_func_card"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/iv_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/cover_text_area"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_album_placeholder"
                        android:alpha="0.3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="暂无封面"
                        android:textColor="#FF8F919A"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 收藏按钮 -->
            <FrameLayout
                android:id="@+id/btn_favorite"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_func_card"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:contentDescription="收藏">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_favorite_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_heart_outline"
                        android:duplicateParentState="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="收藏"
                        android:textColor="#FFF0F0F5"
                        android:textSize="14sp"
                        android:duplicateParentState="true" />
                </LinearLayout>
            </FrameLayout>

            <!-- 搜索同名按钮 -->
            <FrameLayout
                android:id="@+id/btn_search_same"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_func_card"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:contentDescription="搜索同名">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search_line"
                        android:alpha="0.6"
                        android:duplicateParentState="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="搜索同名"
                        android:textColor="#FFF0F0F5"
                        android:textSize="14sp"
                        android:duplicateParentState="true" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- 右侧：歌词区域 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingEnd="30dp">

            <!-- 歌曲信息（歌词上方） -->
            <TextView
                android:id="@+id/tv_song_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#FFF0F0F5"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_song_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FF8F919A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_current_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_source_badge"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="24bit 无损"
                android:textColor="#FF6C8CFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_lyric_above2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FF555A6E"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_lyric_above"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FF8F919A"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tv_lyric_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FF6C8CFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_lyric_below"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FF8F919A"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tv_lyric_below2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FF6B6D75"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_lyric_below3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FF555A6E"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:background="#14FFFFFF" />

    <!-- 进度条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp">

        <FrameLayout
            android:id="@+id/seek_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_seekbar_focus"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:max="100"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:progressTint="#FF6C8CFF"
                android:splitTrack="false"
                android:thumbTint="#FF6C8CFF"
                android:focusable="false"
                android:duplicateParentState="true" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_time_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textColor="#FFF0F0F5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFF0F0F5"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 播放控制按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        android:paddingBottom="10dp">

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_prev"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_control_focus"
            android:contentDescription="上一曲"
            android:padding="8dp"
            android:src="@drawable/ic_track_previous"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true" />

        <FrameLayout
            android:id="@+id/btn_play_pause_container"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_play_btn_large"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <ImageView
                android:id="@+id/btn_play_pause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="播放暂停"
                android:padding="14dp"
                android:src="@drawable/ic_play_dark"
                android:duplicateParentState="true" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btn_next"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_control_focus"
            android:contentDescription="下一曲"
            android:padding="8dp"
            android:src="@drawable/ic_track_next"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true" />

        <ImageView
            android:id="@+id/btn_show_playlist"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_control_focus"
            android:contentDescription="播放列表"
            android:padding="8dp"
            android:src="@drawable/ic_playlist_reference"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>


